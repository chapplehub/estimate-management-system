# プロダクション用環境変数のキー名一覧（Issue #758）
#
# 実ファイルは EC2 上に .env.production として手動配置する（git 管理外・chmod 600）。
# このファイルには値を書かないこと（キー名の文書化のみ）。
#
# 使い方:
#   docker compose -f compose.prod.yaml --env-file .env.production up -d

# --- PostgreSQL（db コンテナの初期化に使用） ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- アプリ / マイグレーション ---
# 形式: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@db:5432/<POSTGRES_DB>
# ホスト名は compose のサービス名 `db`。RDS 移行時はこの値の差し替えのみで対応する
DATABASE_URL=

# --- better-auth ---
# セッション署名用シークレット。生成例: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 公開 URL（例: https://<ドメイン>。ドメイン取得前のローカル検証では http://localhost）
BETTER_AUTH_URL=

# --- イメージ参照の上書き（ローカル検証専用） ---
# EC2 では書かない。デプロイスクリプトが HEAD commit から sha タグを導出してシェル環境変数で
# 渡す（docs/ops/deploy.md）。ロールバックも scripts/deploy.sh <commit> で行い、ここは触らない。
# ローカル検証では必須。GHCR のイメージは arm64 単一アーキ（ADR-20260818-7pn）のため
# x86_64 の開発機では動かない。docker build で作ったローカルタグ（ems-app:local /
# ems-migrate:local）を指定する（docs/ops/prod-docker-local.md）
# APP_IMAGE=
# MIGRATE_IMAGE=

# --- 初期データ投入 seed（任意 / ADR-20260821-4f1） ---
# 公開デモ環境の seed（compose の seed プロファイル）でのみ参照する。
# 未設定・空値なら seed 内の既定値が使われる。
# デモアカウント共通のパスワード。未設定だとリポジトリ内の既定値がそのまま実環境の値になる
# SEED_DEFAULT_PASSWORD=
# 生成するダミー従業員数（既定 2000）。26 未満は不可
# SEED_TOTAL_EMPLOYEES=
